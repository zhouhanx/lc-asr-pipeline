APP_ENV=development
APP_DEBUG=true
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DATABASE=replace-me

# Generate a unique value before implementing token signing.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_CSRF_COOKIE_NAME=lc_asr_csrf
ADMIN_LOGIN_ACCOUNT_MAX_FAILURES=5
ADMIN_LOGIN_SOURCE_MAX_ATTEMPTS=30
ADMIN_LOGIN_IDENTITY_SOURCE_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_LOCK_SECONDS=900
SECURITY_HSTS_SECONDS=31536000
MODEL_PATH=./model
DATA_PATH=./data
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_BATCH_MAX_BYTES=5368709120
RETENTION_SCAN_INTERVAL_SECONDS=3600
RETENTION_ORPHAN_GRACE_SECONDS=86400
RETENTION_BATCH_LIMIT=100
ASR_REQUEST_TIMEOUT_SECONDS=3600
OCR_REQUEST_TIMEOUT_SECONDS=120
OCR_POLL_TIMEOUT_SECONDS=1800

# PaddleOCR official document parsing API. Keep the real token only in .env.
PADDLE_API=replace-with-your-paddleocr-access-token

# Native macOS MLX model service. Keep real secrets only in .env.
LC_ASR_MODEL_DIR=./model
MLX_ASR_BASE_URL=http://127.0.0.1:8765
MLX_ASR_API_KEY=replace-with-a-long-random-service-key
PYANNOTE_AUTH_TOKEN=replace-with-your-hugging-face-token
# Optional production override; only Google Chrome or Microsoft Edge is accepted.
# PDF_BROWSER_PATH=/path/to/google-chrome-or-microsoft-edge
